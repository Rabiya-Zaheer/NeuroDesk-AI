{
  "manifest_version": 3,
  "name": "NeuroDesk Web Capture",
  "version": "0.1.0",
  "description": "Capture selected text or a whole page from the web straight into a NeuroDesk workspace whiteboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
  "http://localhost:3000/*",
  "http://127.0.0.1:3000/*",
  "https://neuro-desk-ai-one.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
